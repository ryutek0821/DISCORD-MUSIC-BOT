# === Required ===
DISCORD_TOKEN=your_discord_bot_token_here
# Discord user IDs allowed to run /refresh and /settings, comma-separated.
# Guild "Manage Server" permission answers a different question than "who
# operates this bot", so name the operators directly. Leave empty to fall back
# to the manage_guild permission check.
BOT_ADMIN_IDS=

# === niconico login (required for niconico playback) ===
# Netscape-format cookie file. yt-dlp reads it and writes refreshed cookies
# back to it, so keep it writable and off the rsync path.
COOKIE_FILE=cookies.txt
# The `user_session` cookie value from a browser already logged in to
# niconico (DevTools > Application > Cookies > nicovideo.jp). niconico's
# login is now an MFA-capable SPA, so this cannot be automated; paste it
# once. Sessions last months. `/refresh` reapplies this value after you
# rotate it.
NICO_SESSION=your_niconico_user_session
# Used only by yt-dlp's own niconico login, as a fallback when no
# user_session is available. Optional.
NICO_EMAIL=your_niconico_email
NICO_PASSWORD=your_niconico_password

# === Optional ===
# Persistent guild session storage (must be outside the deployed repository).
STATE_DIR=~/.local/share/inmermusic
# Disconnect from an idle voice channel after this many seconds.
IDLE_TIMEOUT=180
# How long (seconds) a saved queue stays restorable after a passive
# disconnect. Older snapshots are treated as abandoned.
QUEUE_RESTORE_TTL=86400
# Give up on a single audio download after this many seconds.
DOWNLOAD_TIMEOUT=120
# Directory for downloaded audio files (use a real-disk path, not tmpfs).
DOWNLOAD_DIR=/var/tmp/inmermusic
# Reject tracks longer than this many seconds.
MAX_TRACK_DURATION=1800
# Maximum queued tracks per guild.
MAX_QUEUE_SIZE=100
# Maximum tracks accepted from one playlist command.
MAX_PLAYLIST_SIZE=50
# Guildごとに保存できる名前付きプレイリスト数
MAX_PLAYLISTS_PER_GUILD=25
# Maximum size of the one-track-per-guild prefetch cache.
PREFETCH_MAX_BYTES=268435456
# How often (seconds) to reap orphaned temp downloads while the bot is running.
TEMP_SWEEP_INTERVAL=3600
# Hard per-download ceiling handed to yt-dlp; oversized tracks are refused
# before the transfer rather than filling DOWNLOAD_DIR.
MAX_DOWNLOAD_BYTES=268435456
# If set, also write rotating logs here (journald already captures stdout).
# LOG_FILE=bot.log
# Route YouTube traffic through a residential-IP HTTP proxy to dodge datacenter
# bot detection. Leave unset when the bot already runs on a residential IP.
# YT_PROXY=http://100.114.153.17:8888
# Optional failover list. When set, this takes precedence over YT_PROXY.
# YT_PROXIES=http://user:pass@primary:8888,http://user:pass@secondary:8888
